#!/bin/zsh
# Checks writer outputs against architecture §3.2. Usage:
#   scripts/corpus/verify --manifest <dir>/manifest.json [--check qpdf ...] [--json | --markdown]
# The manifest is written by `swift test` in Packages/LecternKit (default dir: $TMPDIR/lectern-m0a-corpus).
# Uses the repo-root .venv when present; without it, checks that need pikepdf/pyHanko report "skip".
set -euo pipefail
here="${0:A:h}"
root="${here:h:h}"
py="$root/.venv/bin/python"
[[ -x "$py" ]] || py="$(command -v python3)"
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
exec "$py" "$here/verify.py" "$@"
