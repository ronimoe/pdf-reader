#!/bin/zsh
# Lints packaging/homebrew/Casks/lectern.rb the way it will live in the tap:
# creates a temporary local tap named ronimoe/lectern (no git, nothing published),
# runs `brew style` and an offline `brew audit --cask --strict`, then removes the tap.
# Installs nothing and never contacts GitHub.
#
# Usage: scripts/release/check-cask
set -euo pipefail
cd "${0:A:h:h:h}"

TAP=ronimoe/lectern
CASK=packaging/homebrew/Casks/lectern.rb
# Keep the API on: with HOMEBREW_NO_INSTALL_FROM_API, audit clones all of homebrew/core.
export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ANALYTICS=1 HOMEBREW_NO_ENV_HINTS=1
unset HOMEBREW_NO_INSTALL_FROM_API

die() { print -r -- "check-cask: $*" >&2; exit 1; }
[[ -f $CASK ]] || die "$CASK not found"
taps=$(brew tap)
if [[ $'\n'$taps$'\n' == *$'\n'$TAP$'\n'* ]]; then
  die "$TAP is already tapped; this script only uses a throwaway local tap and won't touch an existing one"
fi

created=0
CONFIG=
cleanup() {
  # Untap only the tap this run created.
  if (( created )); then brew untap --force $TAP >/dev/null 2>&1 || true; fi
  [[ -n $CONFIG ]] && rm -rf $CONFIG
  return 0
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# brew audit refuses casks from untrusted taps. Record the trust in a throwaway
# config folder so the user's own trust list (~/.homebrew/trust.json) is untouched.
CONFIG=$(mktemp -d "${TMPDIR:-/tmp}/lectern-check-cask.XXXXXX")
export XDG_CONFIG_HOME=$CONFIG

brew tap-new --no-git $TAP >/dev/null
created=1
TAPDIR="$(brew --repository $TAP)"
mkdir -p $TAPDIR/Casks
cp $CASK $TAPDIR/Casks/lectern.rb
brew trust --cask $TAP/lectern >/dev/null

print -r -- "== brew style $TAP/lectern"
brew style --cask $TAP/lectern
print -r -- "== brew audit --cask --strict $TAP/lectern (offline)"
brew audit --cask --strict $TAP/lectern
print -r -- "== cask OK"
