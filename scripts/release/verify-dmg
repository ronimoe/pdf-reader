#!/bin/zsh
# Checks a DMG made by build-dmg the way a user would meet it, without touching
# any system security setting, and without ever showing a window, a Dock icon or a
# Gatekeeper dialog.
#
#  1. The .sha256 file matches.
#  2. Mounted read-only and hidden (-nobrowse -noautoopen: no Finder window), the image holds
#     Lectern.app, an Applications link, "Read Me First.txt", License.txt and Acknowledgements.txt,
#     plus the window layout: a background, a volume icon (and the volume's custom-icon flag), and
#     a .DS_Store that matches packaging/dmg/layout.json (icon view, window bounds, no toolbars,
#     no arranging, icon positions, icon and text size, labels below) and whose background alias
#     names this volume at /Volumes/<name> and the image's own .background.tiff by path and file
#     id. That is what Finder is told to show; whether Finder draws it as intended can only be
#     seen by opening the DMG.
#  3. A copy of the app in a temporary folder has a valid ad-hoc, sandboxed signature, no
#     get-task-allow, and no quarantine attribute.
#  4. That copy runs its headless self-check: its executable is started directly with
#     -LecternSelfCheck, which checks the bundle, the frameworks, the entitlements the process
#     really has, the sandbox and the PDF engine, prints the result and exits before NSApplication
#     exists (App/Sources/SelfCheck.swift). It must exit 0 within 30 s and leave no crash
#     report, and no window owned by it may be seen while polling every 0.1 s (it lives well under
#     a second, so this is a sample, not proof; the proof is that it never creates NSApplication).
#     The window counter must itself work: it has to see the Dock's windows first, and any error
#     from it fails the run instead of counting as "no windows". No document is opened, and
#     Session.json, the crash journal, recent documents, the Keychain and Sparkle are never
#     touched; it does run inside the user's real sandbox container.
#  5. A simulated browser download: com.apple.quarantine (as Safari sets it) on a copy of the
#     DMG and on a second copy of the app. `spctl --assess -vv` output is recorded for both, and
#     for the clean copy. Neither quarantined copy is ever opened or run.
#
# It refuses to run while any Lectern is running, so it never touches your own session.
# A report is written to build/release/verify-<version>.txt.
#
# Usage: scripts/release/verify-dmg [path/to/Lectern-<version>.dmg]
#        (default: the newest build/release/Lectern-*.dmg)
set -euo pipefail
# Resolve the argument against the caller's directory before changing it.
DMG_ARG=${1:+${1:A}}
ROOT=${0:A:h:h:h}
cd $ROOT

die() { print -r -- "verify-dmg: FAIL: $*" >&2; exit 1; }
say() { print -r -- "== $*"; }

if pgrep -x Lectern >/dev/null; then
  die "Lectern is running (pid $(pgrep -x Lectern | tr '\n' ' ')); quit it first"
fi

if [[ -n $DMG_ARG ]]; then
  DMG=$DMG_ARG
else
  dmgs=(build/release/Lectern-*.dmg(N.om))
  (( ${#dmgs} )) || die "no build/release/Lectern-*.dmg; run scripts/release/build-dmg first"
  DMG=${dmgs[1]:A}
fi
[[ -f $DMG ]] || die "$DMG not found"
VERSION=${${DMG:t:r}#Lectern-}
REPORT=${DMG:h}/verify-$VERSION.txt
command -v uvx >/dev/null || die "uvx not found (it runs the pinned ds_store and mac_alias that read the window layout)"
LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister

exec > >(tee $REPORT) 2>&1
print -r -- "verify-dmg $DMG"
print -r -- "$(date '+%Y-%m-%d %H:%M:%S %z'), macOS $(sw_vers -productVersion) ($(sw_vers -buildVersion))"

# Not Desktop, Documents or Downloads, so the launch triggers no privacy prompt.
TMP=$(mktemp -d "${TMPDIR:-/tmp}/lectern-verify.XXXXXX")
TMP=${TMP:A}
MNT=$TMP/mnt
APP=$TMP/run/Lectern.app
QAPP=$TMP/quarantined/Lectern.app
APP_PID=

is_mounted() { [[ $(/sbin/mount) == *" on $MNT ("* ]]; }
unmount() { # detach, forcing it if a plain detach fails; true only when nothing is left mounted
  is_mounted || return 0
  hdiutil detach -quiet $MNT 2>/dev/null || hdiutil detach -force -quiet $MNT 2>/dev/null || true
  ! is_mounted
}
cleanup() {
  if [[ -n $APP_PID ]] && kill -0 $APP_PID 2>/dev/null; then kill -KILL $APP_PID 2>/dev/null || true; fi
  for app in $APP $QAPP; do [[ -d $app ]] && $LSREGISTER -u $app 2>/dev/null || true; done
  if unmount; then
    rm -rf $TMP
  else
    print -r -- "verify-dmg: $MNT is still mounted; left $TMP in place (hdiutil detach -force $MNT, then remove it)" >&2
  fi
  return 0
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

say "1. checksum"
[[ -f $DMG.sha256 ]] || die "$DMG.sha256 not found"
(cd ${DMG:h} && shasum -a 256 -c ${DMG:t}.sha256) || die "checksum mismatch"
print -r -- "size: $(stat -f %z $DMG) bytes"

say "2. mount read-only and check the contents"
mkdir -p $MNT
hdiutil attach -quiet -readonly -nobrowse -noautoopen -mountpoint $MNT $DMG
ls -lA $MNT | sed 's/^/  /'
[[ -d $MNT/Lectern.app ]] || die "no Lectern.app in the image"
[[ -L $MNT/Applications && $(readlink $MNT/Applications) == /Applications ]] || die "no Applications link"
[[ -f "$MNT/Read Me First.txt" ]] || die "no 'Read Me First.txt'"
grep -q "GNU GENERAL PUBLIC LICENSE" $MNT/License.txt 2>/dev/null || die "no License.txt with the GPL-3.0"
grep -q "Andy Matuschak" $MNT/Acknowledgements.txt 2>/dev/null || die "no Acknowledgements.txt with Sparkle's licence"
[[ -f $MNT/.background.tiff ]] || die "no window background (.background.tiff)"
[[ -f $MNT/.VolumeIcon.icns ]] || die "no volume icon (.VolumeIcon.icns)"
[[ $(GetFileInfo -aC $MNT) == 1 ]] || die "the volume's custom-icon flag isn't set"
[[ -f $MNT/.DS_Store ]] || die "no window layout (.DS_Store)"
# Reads the .DS_Store with the same pinned libraries build-dmg writes it with, so this checks
# what Finder is told, not how Finder draws it.
uvx --quiet --python 3.11 --from dmgbuild==1.6.7 --with ds_store==1.3.3 --with mac_alias==2.2.3 \
  python -I - $MNT packaging/dmg/layout.json "Lectern $VERSION" <<'PY' || die "the window layout is wrong (above), or uvx couldn't run"
import json, os, sys
from ds_store import DSStore
from mac_alias import Alias
mnt, layout, volume = sys.argv[1], json.load(open(sys.argv[2])), sys.argv[3]
with DSStore.open(mnt + "/.DS_Store", "r") as store:
    entries = {(e.filename, e.code): e.value for e in store}
problems = []
def expect(what, found, wanted):
    if found != wanted:
        problems.append(f"{what} is {found!r}, expected {wanted!r}")
for item in [layout["app"], layout["applications"]] + layout["files"]:
    expect(f"{item['name']}'s position", entries.get((item["name"], b"Iloc")), (item["x"], item["y"]))
bwsp, icvp = entries.get((".", b"bwsp"), {}), entries.get((".", b"icvp"), {})
expect("the view", entries.get((".", b"icvl")), b"icnv")
window = layout["window"]
expect("WindowBounds", bwsp.get("WindowBounds"), "{{200, 120}, {%d, %d}}" % (window["width"], window["height"]))
for key in ("ShowToolbar", "ShowSidebar", "ShowStatusBar", "ShowPathbar"):
    expect(key, bwsp.get(key), False)
expect("arrangeBy", icvp.get("arrangeBy"), "none")
expect("iconSize", icvp.get("iconSize"), float(layout["iconSize"]))
expect("textSize", icvp.get("textSize"), float(layout["textSize"]))
expect("labelOnBottom", icvp.get("labelOnBottom"), True)
expect("backgroundType", icvp.get("backgroundType"), 2)
if "backgroundImageAlias" in icvp:
    alias = Alias.from_bytes(icvp["backgroundImageAlias"])
    expect("the background's volume", alias.volume.name, volume)
    expect("the background's volume path", alias.volume.posix_path, "/Volumes/" + volume)
    expect("the background's filesystem", alias.volume.fs_type, b"H+")
    expect("the background's path", alias.target.posix_path, "/.background.tiff")
    expect("the background's folder", alias.target.folder_cnid, 2)
    expect("the background's file id", alias.target.cnid, os.stat(mnt + "/.background.tiff").st_ino)
    print(f"  background alias: {alias.volume.name!r} at {alias.volume.posix_path}, {alias.target.posix_path}")
else:
    problems.append("no background alias")
print(f"  window {bwsp.get('WindowBounds')}, view {entries.get(('.', b'icvl'))!r}, arrangeBy {icvp.get('arrangeBy')!r}, "
      f"icons {icvp.get('iconSize')} pt, text {icvp.get('textSize')} pt, {sum(1 for k in entries if k[1] == b'Iloc')} icon positions")
for line in problems:
    print("  " + line)
sys.exit(1 if problems else 0)
PY
mkdir -p ${APP:h} ${QAPP:h}
ditto $MNT/Lectern.app $APP
ditto $MNT/Lectern.app $QAPP
unmount || die "could not detach $MNT"

say "3. signature of the copied app"
codesign --verify --deep --strict $APP || die "codesign --verify --deep --strict failed"
codesign -dvvv $APP 2>&1 | grep -E '^(Identifier=|CodeDirectory |Signature=|TeamIdentifier=)' | sed 's/^/  /'
ENT=$TMP/entitlements.plist
codesign -d --entitlements - --xml $APP >$ENT 2>/dev/null
[[ $(/usr/libexec/PlistBuddy -c 'Print :com.apple.security.app-sandbox' $ENT 2>/dev/null) == true ]] \
  || die "app-sandbox entitlement missing"
/usr/libexec/PlistBuddy -c 'Print :com.apple.security.get-task-allow' $ENT >/dev/null 2>&1 \
  && die "get-task-allow present"
print -r -- "  app-sandbox: true; get-task-allow: absent; verify --deep --strict: ok"
app_version=$(plutil -extract CFBundleShortVersionString raw -o - $APP/Contents/Info.plist)
[[ $app_version == $VERSION ]] || die "app version $app_version doesn't match the DMG name ($VERSION)"

say "4. headless self-check (no window, no Dock icon)"
# This guard is what keeps a Gatekeeper dialog off the screen: never run a quarantined copy.
if xattr -p com.apple.quarantine $APP >/dev/null 2>&1 \
   || [[ -n $(xattr -r $APP 2>/dev/null | grep com.apple.quarantine) ]]; then
  die "the copy to be run carries com.apple.quarantine; refusing to run it"
fi
cat >$TMP/windows.swift <<'EOF'
import CoreGraphics
import Foundation
guard CommandLine.arguments.count == 2, let pid = Int32(CommandLine.arguments[1]) else { exit(64) }
// No list at all (no window server session) is an error, never "no windows".
guard let windows = CGWindowListCopyWindowInfo([.optionAll], kCGNullWindowID) as? [[String: Any]] else { exit(2) }
print(windows.filter { ($0[kCGWindowOwnerPID as String] as? Int32) == pid }.count)
EOF
swiftc -O -o $TMP/windows $TMP/windows.swift 2>/dev/null || die "could not compile the window counter"
# Positive control, launching nothing: the Dock always owns windows in a logged-in session.
dock=$(pgrep -x Dock | head -1) || die "no Dock process to check the window counter against"
dock_windows=$($TMP/windows $dock) || die "the window counter failed on the Dock"
(( dock_windows >= 1 )) || die "the window counter sees no Dock windows; it can't be trusted to see Lectern's"
print -r -- "  window counter: sees $dock_windows Dock window(s)"

pgrep -x Lectern >/dev/null && die "a Lectern started while this script was running; quit it first"
touch $TMP/launch-marker
$APP/Contents/MacOS/Lectern -LecternSelfCheck >$TMP/selfcheck.txt 2>&1 &
APP_PID=$!
most_windows=0
for _ in {1..300}; do
  kill -0 $APP_PID 2>/dev/null || break
  count=$($TMP/windows $APP_PID) || { kill -KILL $APP_PID 2>/dev/null || true; die "the window counter failed"; }
  (( count > most_windows )) && most_windows=$count
  sleep 0.1
done
if kill -0 $APP_PID 2>/dev/null; then
  kill -KILL $APP_PID 2>/dev/null || true
  cat $TMP/selfcheck.txt
  die "the self-check didn't exit within 30 s"
fi
selfcheck_status=0
wait $APP_PID || selfcheck_status=$?
APP_PID=
sed 's/^/  /' $TMP/selfcheck.txt
(( selfcheck_status == 0 )) || die "the self-check exited with $selfcheck_status"
grep -q '^selfcheck: PASS' $TMP/selfcheck.txt || die "the self-check didn't report PASS"
(( most_windows == 0 )) || die "the self-check owned $most_windows window(s); it must show none"
print -r -- "  exit 0; no window of its own seen while polling every 0.1 s"
crashes=$(find $HOME/Library/Logs/DiagnosticReports -maxdepth 1 -name 'Lectern*' -newer $TMP/launch-marker 2>/dev/null || true)
[[ -z $crashes ]] || die "crash report(s) written: $crashes"
print -r -- "  no crash report"

say "5. simulated browser download (never opened)"
QUARANTINE="0083;$(printf '%x' $(date +%s));Safari;$(uuidgen)"
QDMG=$TMP/quarantined/${DMG:t}
cp $DMG $QDMG
xattr -w com.apple.quarantine $QUARANTINE $QDMG
xattr -w -r com.apple.quarantine $QUARANTINE $QAPP
print -r -- "quarantine on the DMG copy: $(xattr -p com.apple.quarantine $QDMG)"
print -r -- "quarantine on the app copy: $(xattr -p com.apple.quarantine $QAPP)"
# spctl exits non-zero when it rejects; that is a result to record, not an error.
print -r -- "spctl --assess --type open --context context:primary-signature -vv <quarantined DMG>:"
spctl --assess --type open --context context:primary-signature -vv $QDMG 2>&1 | sed 's/^/  /' || true
print -r -- "spctl --assess -vv <quarantined app>:"
spctl --assess -vv $QAPP 2>&1 | sed 's/^/  /' || true
print -r -- "spctl --assess -vv <unquarantined app> (for comparison):"
spctl --assess -vv $APP 2>&1 | sed 's/^/  /' || true

say "PASS"
print -r -- "report: $REPORT"
