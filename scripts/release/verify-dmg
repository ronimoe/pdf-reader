#!/bin/zsh
# Checks a DMG made by build-dmg the way a user would meet it, without touching
# any system security setting and without ever showing a Gatekeeper dialog.
#
#  1. The .sha256 file matches.
#  2. Mounted read-only, the image holds Lectern.app, an Applications link and "Read Me First.txt".
#  3. A copy of the app in a temporary folder has a valid ad-hoc, sandboxed signature and no
#     quarantine attribute. It is launched with `open -n` and a test PDF, must show a window and
#     stay up, then gets SIGTERM and must exit within 10 s without leaving a crash report.
#  4. A simulated browser download: com.apple.quarantine (as Safari sets it) on a copy of the
#     DMG and on a second copy of the app. `spctl --assess -vv` output is recorded for both, and
#     for the clean copy. Neither quarantined copy is ever opened.
#
# It refuses to run while any Lectern is running, so it never touches your own session.
# The test launch passes -ApplePersistenceIgnoreState YES, so it doesn't restore the
# user's saved windows. It still uses the real sandbox container
# (~/Library/Containers/io.github.ronimoe.Lectern), so the temporary test PDF is
# recorded there like any opened document: in File > Open Recent and in Lectern's
# reading state. File > Open Recent > Clear Menu removes both (docs/INSTALL.md).
# A report is written to build/release/verify-<version>.txt.
#
# Usage: scripts/release/verify-dmg [path/to/Lectern-<version>.dmg]
#        (default: the newest build/release/Lectern-*.dmg)
set -euo pipefail
# Resolve the argument against the caller's directory before changing it.
DMG_ARG=${1:+${1:A}}
ROOT=${0:A:h:h:h}
cd $ROOT

die() { print -r -- "verify-dmg: FAIL: $*" >&2; exit 1; }
say() { print -r -- "== $*"; }

if pgrep -x Lectern >/dev/null; then
  die "Lectern is running (pid $(pgrep -x Lectern | tr '\n' ' ')); quit it first"
fi

if [[ -n $DMG_ARG ]]; then
  DMG=$DMG_ARG
else
  dmgs=(build/release/Lectern-*.dmg(N.om))
  (( ${#dmgs} )) || die "no build/release/Lectern-*.dmg; run scripts/release/build-dmg first"
  DMG=${dmgs[1]:A}
fi
[[ -f $DMG ]] || die "$DMG not found"
VERSION=${${DMG:t:r}#Lectern-}
TEST_PDF=$ROOT/Tests/Corpus/public/classic-xref.pdf
[[ -f $TEST_PDF ]] || die "test PDF $TEST_PDF not found"
REPORT=${DMG:h}/verify-$VERSION.txt
LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister

exec > >(tee $REPORT) 2>&1
print -r -- "verify-dmg $DMG"
print -r -- "$(date '+%Y-%m-%d %H:%M:%S %z'), macOS $(sw_vers -productVersion) ($(sw_vers -buildVersion))"

# Not Desktop, Documents or Downloads, so the launch triggers no privacy prompt.
TMP=$(mktemp -d "${TMPDIR:-/tmp}/lectern-verify.XXXXXX")
TMP=${TMP:A}
MNT=$TMP/mnt
APP=$TMP/run/Lectern.app
QAPP=$TMP/quarantined/Lectern.app
APP_PID=

is_mounted() { [[ $(/sbin/mount) == *" on $MNT ("* ]]; }
unmount() { # detach, forcing it if a plain detach fails; true only when nothing is left mounted
  is_mounted || return 0
  hdiutil detach -quiet $MNT 2>/dev/null || hdiutil detach -force -quiet $MNT 2>/dev/null || true
  ! is_mounted
}
cleanup() {
  if [[ -n $APP_PID ]] && kill -0 $APP_PID 2>/dev/null; then kill -KILL $APP_PID 2>/dev/null || true; fi
  for app in $APP $QAPP; do [[ -d $app ]] && $LSREGISTER -u $app 2>/dev/null || true; done
  if unmount; then
    rm -rf $TMP
  else
    print -r -- "verify-dmg: $MNT is still mounted; left $TMP in place (hdiutil detach -force $MNT, then remove it)" >&2
  fi
  return 0
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

say "1. checksum"
[[ -f $DMG.sha256 ]] || die "$DMG.sha256 not found"
(cd ${DMG:h} && shasum -a 256 -c ${DMG:t}.sha256) || die "checksum mismatch"
print -r -- "size: $(stat -f %z $DMG) bytes"

say "2. mount read-only and check the contents"
mkdir -p $MNT
hdiutil attach -quiet -readonly -nobrowse -noautoopen -mountpoint $MNT $DMG
ls -l $MNT | sed 's/^/  /'
[[ -d $MNT/Lectern.app ]] || die "no Lectern.app in the image"
[[ -L $MNT/Applications && $(readlink $MNT/Applications) == /Applications ]] || die "no Applications link"
[[ -f "$MNT/Read Me First.txt" ]] || die "no 'Read Me First.txt'"
mkdir -p ${APP:h} ${QAPP:h}
ditto $MNT/Lectern.app $APP
ditto $MNT/Lectern.app $QAPP
unmount || die "could not detach $MNT"

say "3. signature of the copied app"
codesign --verify --deep --strict $APP || die "codesign --verify --deep --strict failed"
codesign -dvvv $APP 2>&1 | grep -E '^(Identifier=|CodeDirectory |Signature=|TeamIdentifier=)' | sed 's/^/  /'
ENT=$TMP/entitlements.plist
codesign -d --entitlements - --xml $APP >$ENT 2>/dev/null
[[ $(/usr/libexec/PlistBuddy -c 'Print :com.apple.security.app-sandbox' $ENT 2>/dev/null) == true ]] \
  || die "app-sandbox entitlement missing"
/usr/libexec/PlistBuddy -c 'Print :com.apple.security.get-task-allow' $ENT >/dev/null 2>&1 \
  && die "get-task-allow present"
print -r -- "  app-sandbox: true; get-task-allow: absent; verify --deep --strict: ok"
app_version=$(plutil -extract CFBundleShortVersionString raw -o - $APP/Contents/Info.plist)
[[ $app_version == $VERSION ]] || die "app version $app_version doesn't match the DMG name ($VERSION)"

say "4. launch, check, quit"
# This guard is what keeps a Gatekeeper dialog off the screen: never launch a quarantined copy.
if xattr -p com.apple.quarantine $APP >/dev/null 2>&1 \
   || [[ -n $(xattr -r $APP 2>/dev/null | grep com.apple.quarantine) ]]; then
  die "the copy to be launched carries com.apple.quarantine; refusing to launch it"
fi
cp $TEST_PDF $TMP/test.pdf
cat >$TMP/windows.swift <<'EOF'
import CoreGraphics
let pid = Int32(CommandLine.arguments[1])!
let windows = CGWindowListCopyWindowInfo([.optionOnScreenOnly, .excludeDesktopElements], kCGNullWindowID) as? [[String: Any]] ?? []
print(windows.filter { ($0[kCGWindowOwnerPID as String] as? Int32) == pid && ($0[kCGWindowLayer as String] as? Int) == 0 }.count)
EOF
swiftc -O -o $TMP/windows $TMP/windows.swift 2>/dev/null || die "could not compile the window counter"

pattern="${TMP:t}/run/Lectern.app/Contents/MacOS/Lectern"
pgrep -x Lectern >/dev/null && die "a Lectern started while this script was running; quit it first"
touch $TMP/launch-marker
# Don't restore the windows of the user's own Lectern session.
open -g -n -a $APP $TMP/test.pdf --args -ApplePersistenceIgnoreState YES
for _ in {1..30}; do
  APP_PID=$(pgrep -f -- $pattern | head -1) || true
  [[ -n $APP_PID ]] && break
  sleep 0.5
done
[[ -n $APP_PID ]] || die "Lectern did not start within 15 s"
print -r -- "  running: pid $APP_PID ($(ps -o comm= -p $APP_PID))"
windows=0
for _ in {1..20}; do
  windows=$($TMP/windows $APP_PID)
  (( windows > 0 )) && break
  kill -0 $APP_PID 2>/dev/null || die "Lectern exited during launch"
  sleep 0.5
done
(( windows > 0 )) || die "Lectern showed no window within 10 s"
print -r -- "  on-screen windows: $windows"
sleep 3
kill -0 $APP_PID 2>/dev/null || die "Lectern exited on its own after launch"
print -r -- "  still running after 3 s"
kill -TERM $APP_PID
exited=0
for _ in {1..20}; do
  kill -0 $APP_PID 2>/dev/null || { exited=1; break; }
  sleep 0.5
done
(( exited )) || die "Lectern did not exit within 10 s of SIGTERM"
print -r -- "  exited after SIGTERM"
APP_PID=
crashes=$(find $HOME/Library/Logs/DiagnosticReports -maxdepth 1 -name 'Lectern*' -newer $TMP/launch-marker 2>/dev/null || true)
[[ -z $crashes ]] || die "crash report(s) written: $crashes"
print -r -- "  no crash report"

say "5. simulated browser download (never opened)"
QUARANTINE="0083;$(printf '%x' $(date +%s));Safari;$(uuidgen)"
QDMG=$TMP/quarantined/${DMG:t}
cp $DMG $QDMG
xattr -w com.apple.quarantine $QUARANTINE $QDMG
xattr -w -r com.apple.quarantine $QUARANTINE $QAPP
print -r -- "quarantine on the DMG copy: $(xattr -p com.apple.quarantine $QDMG)"
print -r -- "quarantine on the app copy: $(xattr -p com.apple.quarantine $QAPP)"
# spctl exits non-zero when it rejects; that is a result to record, not an error.
print -r -- "spctl --assess --type open --context context:primary-signature -vv <quarantined DMG>:"
spctl --assess --type open --context context:primary-signature -vv $QDMG 2>&1 | sed 's/^/  /' || true
print -r -- "spctl --assess -vv <quarantined app>:"
spctl --assess -vv $QAPP 2>&1 | sed 's/^/  /' || true
print -r -- "spctl --assess -vv <unquarantined app> (for comparison):"
spctl --assess -vv $APP 2>&1 | sed 's/^/  /' || true

say "PASS"
print -r -- "report: $REPORT"
