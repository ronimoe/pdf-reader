#!/bin/zsh
# Tests scripts/install.sh offline, the way people run it (piped into zsh), against fixture
# releases served by a fake curl. Each case checks the exit code, the message, what ends up in the
# destination (its version, and that the installed bundle still passes codesign --strict), and
# that nothing temporary is left: no download folder, no hidden staging folder, no attached image.
#
# Never shows anything on screen: every image, while building fixtures and while installing, is
# attached hidden (-nobrowse) to a folder of its own, never in /Volumes or Finder, and no fixture
# app is ever launched. A "running copy" is a plain `sleep` whose argv[0] is the app's executable
# path. Every installation goes into a folder under this run's temporary folder, never
# /Applications.
#
# Usage: scripts/release/test-install      (scripts/test.sh runs it)
#   LECTERN_TEST_INSTALLER=<file>          test another copy of the installer (for mutation tests)

ROOT=${0:A:h:h:h}

# The tests run in a subshell with errexit; this shell, without it, always cleans up afterwards.
# (In zsh 5.9, errexit inside a nested function exits without running any EXIT trap or `always`
# block, so a trap can't be relied on.)
main() {
  cd "$ROOT"
  INSTALLER=${LECTERN_TEST_INSTALLER:-$ROOT/scripts/install.sh}
  FIX=$(mktemp -d "${TMPDIR:-/tmp}/lectern-test-install.XXXXXX") || exit 1
  FIX=${FIX:A}
  local rc=0
  (
    setopt err_exit pipe_fail no_unset
    SLEEPERS=()
    failures=0
    build_fixtures
    run_cases
    (( failures == 0 ))
  ) || rc=$?
  cleanup
  return $rc
}

cleanup() {
  local line pid command dev
  # Sleepers started in the subshell: plain processes whose command line starts inside $FIX.
  for line in ${(f)"$(ps -axo pid=,command=)"}; do
    read -r pid command <<< "$line"
    [[ $command == "$FIX/"* ]] && kill $pid 2>/dev/null
  done
  for dev in ${(f)"$(hdiutil info | grep -F -- "$FIX" | awk '$1 ~ /^\/dev\// {print $1}' || true)"}; do
    hdiutil detach "$dev" -force -quiet 2>/dev/null || true
  done
  rm -rf -- "$FIX" 2>/dev/null || print -r -- "test-install: couldn't delete $FIX" >&2
}

pass() { print -r -- "✔ install.sh: $*"; }
fail() { print -r -- "✘ install.sh: $*"; failures=$((failures + 1)); }

# --- Fixture releases ------------------------------------------------------------------------
# A bundle around a copy of /usr/bin/true, signed ad-hoc. Never launched.
make_app() { # folder, bundle id, version, [extra resource file]
  local app=$1/Lectern.app
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
  cp /usr/bin/true "$app/Contents/MacOS/Lectern"
  plutil -create xml1 "$app/Contents/Info.plist"
  plutil -insert CFBundleIdentifier -string "$2" "$app/Contents/Info.plist"
  plutil -insert CFBundleExecutable -string Lectern "$app/Contents/Info.plist"
  plutil -insert CFBundlePackageType -string APPL "$app/Contents/Info.plist"
  plutil -insert CFBundleShortVersionString -string "$3" "$app/Contents/Info.plist"
  [[ -n ${4:-} ]] && print "only in $3" > "$app/Contents/Resources/$4"
  codesign -s - -f "$app" 2>/dev/null
}

detach_retrying() {
  local i
  for i in 1 2 3 4 5; do
    hdiutil detach -quiet "$1" 2>/dev/null && return 0
    sleep 1
  done
  hdiutil detach -quiet -force "$1"
}

make_release() { # version, kind
  local version=$1 kind=$2 src=$FIX/src/$1 out=$FIX/releases/v$1
  mkdir -p "$src" "$out"
  case $kind in
    # 9.0.0 has a file 9.0.1 lacks: copying over the old bundle instead of replacing it would
    # leave it behind, and the installed bundle would fail codesign --strict.
    good-old) make_app "$src" io.github.ronimoe.Lectern "$version" only-in-old.txt ;;
    good|mismatch|other-file|empty-sha) make_app "$src" io.github.ronimoe.Lectern "$version" ;;
    # As a browser would leave it: the installer must remove the mark. Never launched, so macOS
    # never evaluates it.
    quarantined) make_app "$src" io.github.ronimoe.Lectern "$version"
      xattr -w com.apple.quarantine "0083;00000000;Safari;" "$src/Lectern.app" ;;
    bad-id) make_app "$src" com.example.NotLectern "$version" ;;
    bad-seal) make_app "$src" io.github.ronimoe.Lectern "$version"; print added > "$src/Lectern.app/Contents/Resources/added.txt" ;;
    no-app) print "no app here" > "$src/README.txt" ;;
  esac
  # An empty image, attached hidden to a folder of ours, filled with ditto, then converted to a
  # compressed read-only image like the release's. (makehybrid would skip the attach, but it gives
  # the bundle Finder info, which codesign --strict rightly rejects.)
  local dmg=$out/Lectern-$version.dmg rw=$FIX/rw-$version.dmg mnt=$FIX/mnt-$version
  mkdir -p "$mnt"
  hdiutil create -quiet -size 4m -fs HFS+ -layout NONE -volname "Lectern $version" "$rw"
  hdiutil attach -quiet -nobrowse -noautoopen -mountpoint "$mnt" "$rw" < /dev/null
  ditto "$src" "$mnt"
  detach_retrying "$mnt"
  hdiutil convert -quiet "$rw" -format UDZO -o "$dmg"
  rm -f -- "$rw"
  case $kind in
    mismatch) print -r -- "$(printf '%064d' 0)  Lectern-$version.dmg" > "$dmg.sha256" ;;
    other-file) shasum -a 256 /usr/bin/true > "$dmg.sha256" ;;
    empty-sha) : > "$dmg.sha256" ;;
    *) (cd "$out" && shasum -a 256 "Lectern-$version.dmg" > "Lectern-$version.dmg.sha256") ;;
  esac
}

build_fixtures() {
  make_release 9.0.0 good-old
  make_release 9.0.1 good
  make_release 9.0.2 quarantined
  make_release 9.1.0 mismatch
  make_release 9.1.1 other-file
  make_release 9.1.2 empty-sha
  make_release 9.1.3 no-app
  make_release 9.1.4 bad-id
  make_release 9.1.5 bad-seal

  mkdir -p "$FIX/bin" "$FIX/tmp" "$FIX/brew-empty" "$FIX/zdotdir-empty" "$FIX/zdotdir-alias"
  # A user's ~/.zshenv that aliases mv: the installer must not be fooled by it.
  print -r -- "alias mv='echo MV-ALIAS'" > "$FIX/zdotdir-alias/.zshenv"

  # Fake curl: serves $FAKE_RELEASES/v<version>/<file> for .../releases/download/v<version>/<file>,
  # and answers the releases/latest redirect with $FAKE_LATEST.
  cat > "$FIX/bin/curl" <<'EOF'
#!/bin/zsh
out= url= head=0
while (( $# )); do
  case $1 in
    -o|-w|--proto|--proto-redir) [[ $1 == -o ]] && out=$2; shift 2 ;;
    -*I*) head=1; shift ;;
    -*) shift ;;
    *) url=$1; shift ;;
  esac
done
[[ -n ${FAKE_CURL_DELAY:-} ]] && sleep $FAKE_CURL_DELAY
case $url in
  https://github.com/ronimoe/pdf-reader/releases/latest)
    (( head )) && print -rn -- "https://github.com/ronimoe/pdf-reader/releases/tag/v$FAKE_LATEST" ;;
  https://github.com/ronimoe/pdf-reader/releases/download/*)
    file=$FAKE_RELEASES/${url#*/releases/download/}
    [[ -f $file ]] || { print -u2 "curl: (22) The requested URL returned error: 404"; exit 22; }
    cp -- "$file" "$out" ;;
  *) print -u2 "fake curl: unexpected URL $url"; exit 7 ;;
esac
EOF
  cat > "$FIX/bin/brew" <<'EOF'
#!/bin/zsh
[[ $1 == --prefix ]] && print -r -- "$FAKE_BREW_PREFIX"
EOF
  # Fake mv: with FAKE_MV_FAIL set, fails the move of the new copy into place ("in"), that and
  # the move of the previous copy back ("both"), or sends TERM to the installer and fails between
  # the two moves ("term"). Everything else goes to /bin/mv.
  cat > "$FIX/bin/mv" <<'EOF'
#!/bin/zsh
src=${@[-2]}
case ${FAKE_MV_FAIL:-}:$src in
  in:*/.lectern-install.*/Lectern.app|both:*/.lectern-install.*/Lectern.app|both:*/previous.app)
    print -u2 "mv: fake failure for $src"; exit 1 ;;
  term:*/.lectern-install.*/Lectern.app)
    kill -TERM $PPID; print -u2 "mv: fake failure after TERM"; exit 1 ;;
esac
exec /bin/mv "$@"
EOF
  chmod +x "$FIX/bin/curl" "$FIX/bin/brew" "$FIX/bin/mv"
}

# --- Running the installer -------------------------------------------------------------------
# The destination has a quote, parentheses and spaces: the trap and the running-copy check must
# treat it literally.
APPS= TARGET= OUT= RC=
installer_env() { # the environment every run gets, then the caller's VAR=value overrides
  print -r -- PATH="$FIX/bin:$PATH" TMPDIR="$FIX/tmp" FAKE_RELEASES="$FIX/releases" FAKE_LATEST=9.0.1 \
    FAKE_BREW_PREFIX="$FIX/brew-empty" ZDOTDIR="$FIX/zdotdir-empty" LECTERN_APPDIR="$APPS"
}
install_with() { # VAR=value ... : runs install.sh piped into zsh, like curl … | zsh
  local appdir=$APPS arg
  for arg in "$@"; do [[ $arg == LECTERN_APPDIR=* ]] && appdir=${arg#LECTERN_APPDIR=}; done
  [[ ${appdir:A} == $FIX/* ]] || { print -r -- "test-install: refusing to install outside $FIX" >&2; exit 1; }
  RC=0
  OUT=$(env PATH="$FIX/bin:$PATH" TMPDIR="$FIX/tmp" FAKE_RELEASES="$FIX/releases" FAKE_LATEST=9.0.1 \
    FAKE_BREW_PREFIX="$FIX/brew-empty" ZDOTDIR="$FIX/zdotdir-empty" LECTERN_APPDIR="$APPS" "$@" \
    zsh < "$INSTALLER" 2>&1) || RC=$?
}
installed_version() { plutil -extract CFBundleShortVersionString raw "$TARGET/Contents/Info.plist" 2>/dev/null || print none; }
leftovers() { # anything temporary that survived
  local left=()
  left+=(${(f)"$(find "$FIX/tmp" "$APPS" -mindepth 1 -maxdepth 1 \( -path "$FIX/tmp/*" -o -name '.lectern-install.*' \) 2>/dev/null || true)"})
  hdiutil info | grep -qF -- "$FIX/tmp" && left+=(an-attached-image)
  print -r -- "${left[*]}"
}
intact() { # the installed bundle passes codesign --strict and holds no app inside it
  [[ ! -e $TARGET ]] && return 0
  codesign --verify --deep --strict "$TARGET" 2>/dev/null || return 1
  [[ -z $(find "$TARGET" -mindepth 1 -maxdepth 2 -name '*.app' 2>/dev/null) ]]
}
expect() { # name, expected rc ("0", "fail" or a number), message substring, expected installed version
  local name=$1 want_rc=$2 want_msg=$3 want_version=$4 problems=()
  case $want_rc in
    0) (( RC == 0 )) || problems+=("exit $RC") ;;
    fail) (( RC != 0 )) || problems+=("exit 0") ;;
    *) (( RC == want_rc )) || problems+=("exit $RC, expected $want_rc") ;;
  esac
  [[ $OUT == *"$want_msg"* ]] || problems+=("no '$want_msg' in output")
  [[ $(installed_version) == $want_version ]] || problems+=("installed $(installed_version), expected $want_version")
  intact || problems+=("the installed bundle fails codesign --strict or holds another app")
  [[ -z $(leftovers) ]] || problems+=("left behind: $(leftovers)")
  if (( ${#problems} )); then fail "$name: ${(j:; :)problems}"; print -r -- "$OUT" | sed 's/^/    /'; else pass "$name"; fi
}
start_sleeper() { # a plain process whose command line looks like Lectern running from $TARGET
  zsh -c 'exec -a "$1" sleep 60' _ "$TARGET/Contents/MacOS/Lectern" &
  SLEEPERS+=($!)
}
stop_sleeper() { kill $SLEEPERS[-1] 2>/dev/null || true; wait $SLEEPERS[-1] 2>/dev/null || true; }

run_cases() {
  APPS="$FIX/apps/Bob's (x) Apps"
  TARGET=$APPS/Lectern.app

  install_with LECTERN_VERSION=9.0.0
  expect "fresh install into a path with ' ( ) and spaces" 0 "installed $TARGET" 9.0.0

  install_with
  expect "the latest release replaces the previous copy whole" 0 "Lectern 9.0.1 into" 9.0.1

  install_with LECTERN_VERSION=9.0.2
  expect "a quarantined app in the DMG" 0 "installed" 9.0.2
  [[ -z $(xattr -r "$TARGET" 2>/dev/null | grep com.apple.quarantine) ]] && pass "the quarantine mark is removed" \
    || fail "the installed copy still has a quarantine mark"

  install_with LECTERN_VERSION=9.0.1 ZDOTDIR="$FIX/zdotdir-alias"
  expect "an alias for mv in ~/.zshenv is ignored" 0 "installed" 9.0.1

  install_with LECTERN_VERSION=9.1.0
  expect "checksum mismatch is refused" fail "doesn't match its published SHA-256" 9.0.1
  install_with LECTERN_VERSION=9.1.1
  expect ".sha256 naming another file is refused" fail "doesn't match its published SHA-256" 9.0.1
  install_with LECTERN_VERSION=9.1.2
  expect "empty .sha256 is refused" fail "doesn't hold a SHA-256" 9.0.1
  install_with LECTERN_VERSION=9.1.3
  expect "a DMG without Lectern.app is refused" fail "has no Lectern.app" 9.0.1
  install_with LECTERN_VERSION=9.1.4
  expect "a wrong bundle identifier is refused" fail "bundle identifier 'com.example.NotLectern'" 9.0.1
  install_with LECTERN_VERSION=9.1.5
  expect "a broken signature is refused" fail "failed its signature check" 9.0.1
  install_with LECTERN_VERSION=9.9.9
  expect "a missing release is refused" fail "couldn't download Lectern-9.9.9.dmg" 9.0.1
  install_with "LECTERN_VERSION=1;rm"
  expect "a malformed version is refused" fail "unexpected version" 9.0.1
  install_with LECTERN_VERSION=v9.0.0
  expect "a version given with a leading v" 0 "Lectern 9.0.0 into" 9.0.0

  # The swap: the previous copy comes back when the new one can't be moved in.
  install_with LECTERN_VERSION=9.0.1 FAKE_MV_FAIL=in
  expect "a failed move puts the previous copy back" fail "any previous copy was put back" 9.0.0
  install_with LECTERN_VERSION=9.0.1 FAKE_MV_FAIL=term
  expect "TERM between the two moves puts the previous copy back" 143 "" 9.0.0
  # Both moves fail: no app, and the previous copy must be kept and named, never deleted.
  install_with LECTERN_VERSION=9.0.1 FAKE_MV_FAIL=both
  local kept=("$APPS"/.lectern-install.*/previous.app(N))
  if (( RC != 0 )) && [[ $OUT == *"it is at $APPS/.lectern-install."*"/previous.app"* && $(installed_version) == none && ${#kept} == 1 ]]; then
    pass "when the previous copy can't be put back, it is kept and named"
  else
    fail "both moves failing: exit $RC, installed $(installed_version), kept ${#kept}"; print -r -- "$OUT" | sed 's/^/    /'
  fi
  if (( ${#kept} == 1 )); then
    /bin/mv -- "$kept[1]" "$TARGET" && rm -rf -- "${kept[1]:h}"
  fi

  # A running copy: refused before the download, and when it starts during the download.
  start_sleeper; sleep 0.5
  install_with LECTERN_VERSION=9.0.1
  expect "a copy running from the destination is never replaced" fail "Lectern is running from $TARGET" 9.0.0
  stop_sleeper
  local out_file=$FIX/late-start.out
  ( env PATH="$FIX/bin:$PATH" TMPDIR="$FIX/tmp" FAKE_RELEASES="$FIX/releases" FAKE_LATEST=9.0.1 \
      FAKE_BREW_PREFIX="$FIX/brew-empty" ZDOTDIR="$FIX/zdotdir-empty" LECTERN_APPDIR="$APPS" \
      LECTERN_VERSION=9.0.1 FAKE_CURL_DELAY=2 zsh < "$INSTALLER" > "$out_file" 2>&1 ) &
  local pid=$!
  sleep 1; start_sleeper
  RC=0; wait $pid || RC=$?
  OUT=$(<"$out_file"); rm -f -- "$out_file"
  expect "a copy started during the download is never replaced" fail "Lectern is running from $TARGET" 9.0.0
  stop_sleeper

  mkdir -p "$FIX/brew-managed/Caskroom/lectern"
  install_with FAKE_BREW_PREFIX="$FIX/brew-managed"
  expect "a Homebrew-managed Lectern is left to Homebrew" fail "Homebrew manages Lectern" 9.0.0

  # Interrupted while downloading: the trap must still clean up and keep the previous copy. A job
  # started with & ignores SIGINT, so perl restores the default first, as a terminal's Ctrl-C
  # finds it.
  local sig code
  for sig code in INT 130 TERM 143; do
    RC=0
    env PATH="$FIX/bin:$PATH" TMPDIR="$FIX/tmp" FAKE_RELEASES="$FIX/releases" FAKE_LATEST=9.0.1 \
      FAKE_BREW_PREFIX="$FIX/brew-empty" ZDOTDIR="$FIX/zdotdir-empty" LECTERN_APPDIR="$APPS" FAKE_CURL_DELAY=2 \
      perl -e '$SIG{INT} = "DEFAULT"; exec @ARGV or die' zsh "$INSTALLER" >/dev/null 2>&1 &
    pid=$!
    sleep 1
    kill -$sig $pid
    wait $pid || RC=$?
    OUT=
    expect "$sig during the download cleans up" $code "" 9.0.0
  done

  RC=0; OUT=$(sh "$INSTALLER" 2>&1) || RC=$?
  if (( RC != 0 )) && [[ $OUT == *"run this with zsh"* ]]; then pass "sh is refused with a message"
  else fail "sh: exit $RC, output: $OUT"; fi

  # Cut off two thirds of the way through, inside the function: zsh must fail to parse it and run
  # nothing at all.
  local fresh="$FIX/apps/never created" size
  size=$(wc -c < "$INSTALLER")
  RC=0
  head -c $((size * 2 / 3)) "$INSTALLER" | env PATH="$FIX/bin:$PATH" TMPDIR="$FIX/tmp" \
    FAKE_RELEASES="$FIX/releases" FAKE_LATEST=9.0.1 FAKE_BREW_PREFIX="$FIX/brew-empty" \
    ZDOTDIR="$FIX/zdotdir-empty" LECTERN_APPDIR="$fresh" zsh >/dev/null 2>&1 || RC=$?
  if (( RC != 0 )) && [[ ! -e $fresh && -z $(leftovers) ]]; then pass "a cut-off script runs nothing"
  else fail "a cut-off script: exit $RC, created '$fresh': $([[ -e $fresh ]] && print yes || print no)"; fi
}

main "$@"
